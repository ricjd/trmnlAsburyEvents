{% comment %}
  Half vertical layout (400x480) — paste into the "Half vertical" tab.
  Same structure as Full, just narrower — rows will wrap more.

  lg: classes bump text size on TRMNL X (>=1024px); OG never reaches that
  breakpoint so its appearance is unchanged.

  This panel is full-height on both devices, but TRMNL X's is dramatically
  taller than OG's fixed 480px canvas. The worker sends more day-buckets
  than OG can safely fit (compact_day_count marks the cutoff); the extra
  ones are wrapped in `hidden lg:visible` so only TRMNL X reveals them.
{% endcomment %}
<div class="layout">
  <div class="columns">
    <div class="column">
      {% if days and days.size > 0 %}
        {% for day in days %}
          {% if forloop.index0 >= compact_day_count %}
            {% assign extra_class = " hidden lg:visible" %}
          {% else %}
            {% assign extra_class = "" %}
          {% endif %}
          <div class="item bg--gray-70{{ extra_class }}">
            <div class="content">
              <span class="title title--small lg:title--large">{{ day.label }} &middot; {{ day.date }}</span>
            </div>
          </div>
          {% for e in day.events %}
            <div class="item{{ extra_class }}">
              <div class="content">
                <span class="label label--small lg:label--large">{{ e.time }}</span>
                <span class="title title--small lg:title--large">{{ e.title }}</span>
              </div>
            </div>
          {% endfor %}
        {% endfor %}
      {% else %}
        <span class="label">No upcoming events.</span>
      {% endif %}
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title title--large lg:title--xlarge">{{ plugin_title | default: "Beach House" }}</span>
</div>
